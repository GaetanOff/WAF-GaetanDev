{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/GaetanDev/WAF/schemas/config.schema.json",
  "title": "WAFConfig",
  "description": "Configuration complète du WAF Anti-DDoS/Anti-Bot",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "server", "upstream"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Version du schéma de configuration",
      "example": "1.0"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listen"],
      "properties": {
        "listen": {
          "type": "string",
          "description": "Adresse d'écoute du proxy public",
          "example": ":8080"
        },
        "admin_listen": {
          "type": "string",
          "description": "Adresse d'écoute de l'API admin (port séparé)",
          "default": ":9090",
          "example": "127.0.0.1:9090"
        },
        "read_timeout": {
          "type": "string",
          "description": "Timeout de lecture HTTP (format Go duration)",
          "default": "30s",
          "example": "30s"
        },
        "write_timeout": {
          "type": "string",
          "default": "30s"
        },
        "idle_timeout": {
          "type": "string",
          "default": "60s"
        },
        "graceful_shutdown_timeout": {
          "type": "string",
          "default": "15s"
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address"],
      "description": "Upstream par défaut (si aucun domaine spécifique ne correspond)",
      "properties": {
        "address": {
          "type": "string",
          "description": "URL de l'upstream par défaut",
          "example": "http://nginx:80"
        },
        "timeout": {
          "type": "string",
          "default": "30s"
        },
        "tls_verify": {
          "type": "boolean",
          "default": true,
          "description": "Vérifier le certificat TLS upstream"
        },
        "max_idle_conns": {
          "type": "integer",
          "default": 100,
          "minimum": 1
        }
      }
    },
    "cloudflare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trusted": {
          "type": "boolean",
          "default": true,
          "description": "Faire confiance aux headers Cloudflare (CF-Connecting-IP)"
        },
        "auto_update_ranges": {
          "type": "boolean",
          "default": false,
          "description": "Mettre à jour automatiquement les plages IP Cloudflare depuis l'API"
        },
        "update_interval": {
          "type": "string",
          "default": "24h"
        }
      }
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "requests_per_second": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Tokens par seconde (Token Bucket refill rate)"
        },
        "burst": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "description": "Capacité maximale du bucket (burst)"
        },
        "requests_per_minute": {
          "type": "integer",
          "default": 1000
        },
        "requests_per_hour": {
          "type": "integer",
          "default": 10000
        }
      }
    },
    "antiddos": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "global_requests_per_second": {
          "type": "integer",
          "default": 50000,
          "minimum": 1,
          "description": "Seuil global de trafic en req/s avant activation du mode dégradé"
        },
        "global_window": {
          "type": "string",
          "default": "1s",
          "description": "Fenêtre glissante utilisée pour compter le trafic global"
        },
        "retry_after_seconds": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "description": "Valeur du header Retry-After en mode dégradé"
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initial_score": {
          "type": "integer",
          "default": 50,
          "minimum": 0,
          "maximum": 100
        },
        "challenge_threshold": {
          "type": "integer",
          "default": 40,
          "minimum": 0,
          "maximum": 100,
          "description": "Score en dessous duquel le challenge JS est déclenché"
        },
        "block_threshold": {
          "type": "integer",
          "default": 10,
          "minimum": 0,
          "maximum": 100,
          "description": "Score en dessous duquel la requête est bloquée (403)"
        },
        "score_ttl": {
          "type": "string",
          "default": "1h",
          "description": "Durée de vie du score en mémoire sans activité"
        },
        "max_visitors": {
          "type": "integer",
          "default": 100000,
          "description": "Nombre maximum de visiteurs en mémoire (LRU eviction au-delà)"
        }
      }
    },
    "risk_engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "profile": {
          "type": "string",
          "enum": ["lenient", "balanced", "strict"],
          "default": "balanced"
        },
        "shadow_mode": {
          "type": "boolean",
          "default": false
        },
        "block_min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.6
        },
        "min_corroborating_families": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "tiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observe": { "type": "integer", "minimum": 0, "maximum": 100, "default": 25 },
            "throttle": { "type": "integer", "minimum": 0, "maximum": 100, "default": 45 },
            "challenge": { "type": "integer", "minimum": 0, "maximum": 100, "default": 65 },
            "tarpit": { "type": "integer", "minimum": 0, "maximum": 100, "default": 80 },
            "block": { "type": "integer", "minimum": 0, "maximum": 100, "default": 90 }
          }
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reputation": { "type": "number", "minimum": 0, "default": 1.0 },
            "behavioral": { "type": "number", "minimum": 0, "default": 1.0 },
            "tls": { "type": "number", "minimum": 0, "default": 0.8 },
            "fingerprint": { "type": "number", "minimum": 0, "default": 1.0 },
            "integrity": { "type": "number", "minimum": 0, "default": 1.2 },
            "rate": { "type": "number", "minimum": 0, "default": 0.6 },
            "geo": { "type": "number", "minimum": 0, "default": 0.5 },
            "human_credit": { "type": "number", "minimum": 0, "default": 1.0 }
          }
        },
        "family_corroboration_threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 50
        },
        "human_credit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "challenge_passed": { "type": "integer", "minimum": -100, "maximum": 0, "default": -40 },
            "stable_fingerprint": { "type": "integer", "minimum": -100, "maximum": 0, "default": -15 },
            "sticky_trust_ttl": { "type": "string", "default": "30m" }
          }
        },
        "verified_bots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "success_cache_ttl": { "type": "string", "default": "12h" },
            "failure_cache_ttl": { "type": "string", "default": "10m" },
            "crawlers": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["googlebot", "bingbot", "duckduckbot", "applebot"]
            }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "max_body_bytes": { "type": "integer", "minimum": 1, "default": 10485760 },
        "max_path_length": { "type": "integer", "minimum": 1, "default": 2048 },
        "max_query_length": { "type": "integer", "minimum": 1, "default": 4096 }
      }
    },
    "behavioral": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "max_records": { "type": "integer", "minimum": 1, "default": 50 }
      }
    },
    "threat_intel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "cache_ttl": { "type": "string", "default": "1h" },
        "blocklist_cidrs": { "type": "array", "items": { "type": "string" } },
        "suspect_cidrs": { "type": "array", "items": { "type": "string" } },
        "abuseipdb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "url": { "type": "string" },
            "api_key": { "type": "string" }
          }
        }
      }
    },
    "adaptive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "max_difficulty": { "type": "integer", "minimum": 8, "maximum": 32, "default": 24 },
        "decay_tau": { "type": "string", "default": "5m" }
      }
    },
    "geo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "allowed_countries": { "type": "array", "items": { "type": "string" } },
        "blocked_countries": { "type": "array", "items": { "type": "string" } },
        "challenge_countries": { "type": "array", "items": { "type": "string" } },
        "challenge_contribution": { "type": "integer", "minimum": 0, "maximum": 100, "default": 60 }
      }
    },
    "tls_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "ja3_header": { "type": "string", "default": "Cf-Bot-Management-Ja3Hash" },
        "ja3_blacklist": { "type": "array", "items": { "type": "string" } },
        "swap_contribution": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 }
      }
    },
    "deception": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "tarpit_max_connections": { "type": "integer", "minimum": 1, "default": 500 },
        "tarpit_chunks": { "type": "integer", "minimum": 1, "default": 20 },
        "tarpit_chunk_delay": { "type": "string", "default": "1s" }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "file": { "type": "string" }
      }
    },
    "origin_protection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "secret": { "type": "string" }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "channel": { "type": "string", "default": "waf:events" }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "secret_key": {
          "type": "string",
          "description": "Clé secrète HMAC. Préférer WAF_CHALLENGE_SECRET_KEY env var",
          "minLength": 32
        },
        "token_ttl": {
          "type": "string",
          "default": "30s",
          "description": "Durée de validité du nonce de challenge"
        },
        "cookie_ttl": {
          "type": "string",
          "default": "24h",
          "description": "Durée de validité du cookie de session"
        },
        "cookie_name": {
          "type": "string",
          "default": "waf_session"
        },
        "pow_difficulty": {
          "type": "integer",
          "default": 16,
          "minimum": 8,
          "maximum": 24,
          "description": "Nombre de bits de difficulté du proof-of-work (16 ≈ 500ms)"
        },
        "min_elapsed_ms": {
          "type": "integer",
          "default": 500,
          "description": "Durée minimale du challenge en ms (en dessous = bot suspect)"
        },
        "max_elapsed_ms": {
          "type": "integer",
          "default": 10000,
          "description": "Durée maximale du challenge en ms"
        }
      }
    },
    "whitelist": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "IP ou CIDR (ex: 192.168.0.0/16 ou 1.2.3.4)"
      },
      "default": []
    },
    "blacklist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "whitelist_user_agents": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Regex pattern de user-agents à whitelister (ex: Googlebot)"
      },
      "default": [
        "Googlebot",
        "Bingbot",
        "Slurp",
        "DuckDuckBot",
        "Baiduspider",
        "facebookexternalhit",
        "LinkedInBot",
        "Twitterbot"
      ]
    },
    "honeypot_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "/.env",
        "/wp-admin",
        "/wp-login.php",
        "/.git/config",
        "/phpinfo.php",
        "/admin.php"
      ],
      "description": "Chemins honeypot : toute requête déclenche un score = 0 + log"
    },
    "domains": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DomainConfig"
      },
      "default": []
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "default": "info"
        },
        "format": {
          "type": "string",
          "enum": ["json", "pretty"],
          "default": "json"
        },
        "output": {
          "type": "string",
          "enum": ["stdout", "stderr"],
          "default": "stdout"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["memory", "redis"],
          "default": "memory"
        },
        "redis": {
          "$ref": "#/definitions/RedisConfig"
        }
      }
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "token": {
          "type": "string",
          "description": "Bearer token pour l'API admin. Préférer WAF_ADMIN_TOKEN env var",
          "minLength": 32
        }
      }
    }
  },
  "definitions": {
    "DomainConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "upstream"],
      "properties": {
        "host": {
          "type": "string",
          "description": "Nom de domaine (correspondance exacte ou wildcard *.example.com)",
          "example": "example.com"
        },
        "upstream": {
          "type": "string",
          "description": "URL upstream pour ce domaine",
          "example": "http://10.0.0.1:80"
        },
        "challenge_enabled": {
          "type": "boolean",
          "default": true
        },
        "rate_limit_override": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests_per_second": { "type": "number" },
            "burst": { "type": "integer" }
          }
        },
        "trust_override": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "challenge_threshold": { "type": "integer" },
            "block_threshold": { "type": "integer" }
          }
        },
        "protected_paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths qui déclenchent systématiquement le challenge"
        },
        "public_paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths qui ne déclenchent jamais le challenge"
        }
      }
    },
    "RedisConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address"],
      "properties": {
        "address": {
          "type": "string",
          "example": "redis:6379"
        },
        "password": {
          "type": "string",
          "description": "Préférer WAF_REDIS_PASSWORD env var"
        },
        "db": {
          "type": "integer",
          "default": 0
        },
        "tls": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
