# Secrets locaux : le build stage fait `COPY . .`, ils finiraient dans ses
# couches (cache de build, image intermédiaire poussée par erreur).
.env
.env.*
*.pem
*.key
*.crt
*.p12

# Build artifacts
waf
waf.exe
*.exe
*.o
coverage.out

# Git & CI
.git
.github
.gitignore
.gitattributes

# Docs & specs (not needed in the runtime image)
docs
specs
examples
templates
.cursor

# Editor / OS noise
.idea
.vscode
*.log
.DS_Store
